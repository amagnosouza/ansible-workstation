# Zsh Configuration Template
# Generated by Ansible - Fedora Workstation Professional Setup

export ZSH=$HOME/.oh-my-zsh

# Zsh Theme
ZSH_THEME="{{ zsh_theme }}"

# Plugins
plugins=(git podman kubectl docker colored-man-pages)

# Enable completion
autoload -U compinit && compinit

# Source Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Starship Prompt
eval "$(starship init zsh)"

# User Configuration
export EDITOR='vim'
export LANG=en_US.UTF-8

# Aliases
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'

# History
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=$HOME/.zsh_history
setopt SHARE_HISTORY

# Custom PATH
export PATH="$PATH:$HOME/.local/bin:/usr/local/bin"

# Podman settings
export CONTAINER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
