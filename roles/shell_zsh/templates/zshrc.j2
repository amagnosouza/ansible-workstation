# Zsh Configuration Template
# Generated by Ansible - Fedora Workstation Professional Setup

export ZSH=$HOME/.oh-my-zsh

# Zsh Theme
ZSH_THEME="{{ zsh_theme }}"

# Plugins
plugins=(git podman kubectl docker colored-man-pages)

# Source Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Zsh plugins installed from Fedora packages
[[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
[[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# fzf: fuzzy history search with Ctrl+R and fuzzy completion with Tab
[[ -r /usr/share/fzf/shell/key-bindings.zsh ]] && \
  source /usr/share/fzf/shell/key-bindings.zsh
[[ -r /usr/share/fzf/shell/completion.zsh ]] && \
  source /usr/share/fzf/shell/completion.zsh

# Starship Prompt
eval "$(starship init zsh)"

# User Configuration
export EDITOR='vim'
export LANG=en_US.UTF-8

# Aliases
alias ls='lsd'
alias ll='lsd -lah'
alias la='lsd -A'
alias l='lsd -l'
alias grep='grep --color=auto'

# History
HISTSIZE=5000
SAVEHIST=5000
HISTFILE=$HOME/.zsh_history
setopt SHARE_HISTORY

# Custom PATH
export PATH="$PATH:$HOME/.local/bin:/usr/local/bin"

# Podman settings
export CONTAINER_HOST="unix:///run/user/$(id -u)/podman/podman.sock"
